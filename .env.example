# ── Groq (LLM inference for the TripSync agent) ──────────────────────────────
# Get your key at: https://console.groq.com   (copy this file to .env and fill it in)
GROQ_API_KEY=your_groq_api_key_here
# Default model; alternatives: llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-120b

# ── Gnani (voice rail, optional until Gate 2 voice work) ─────────────────────
GNANI_API_KEY=your_gnani_api_key_here

# ── Partner sandboxes (optional, Phase 0.1 / Phase 3-4) ──────────────────────
PINELABS_API_KEY=your_pine_labs_sandbox_key_here
